/* Тёмная тактическая тема тренажёра стрельбы по БПЛА.
 *
 * Палитра:
 *   фон        #1E1E1E
 *   акцент     #00FF41
 *   текст      #FFFFFF / #CCCCCC
 *   успех      #00FF00
 *   ошибка     #FF5555
 */

QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11pt;
}

QFrame {
    border: 1px solid #3A3A3A;
    background-color: #252525;
}

QLabel {
    color: #CCCCCC;
    background-color: transparent;
    border: none;
    padding: 4px;
}

QLabel#status_active {
    color: #00FF41;
    font-weight: bold;
}

QLabel#status_inactive {
    color: #888888;
    font-weight: bold;
}

QGroupBox {
    background-color: #252525;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    margin-top: 10px;
    padding: 8px;
    font-weight: bold;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #00FF41;
}

QPushButton {
    background-color: #2A2A2A;
    color: #FFFFFF;
    border: 1px solid #00FF41;
    border-radius: 4px;
    padding: 8px 12px;
    min-height: 44px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #00FF41;
    color: #000000;
}

QPushButton:pressed {
    background-color: #00CC33;
    color: #000000;
}

QPushButton:disabled {
    background-color: #333333;
    color: #777777;
    border-color: #555555;
}

QPushButton#accent {
    background-color: #00FF41;
    color: #000000;
}

QPushButton#accent:hover {
    background-color: #33FF66;
}

QPushButton#accent:pressed {
    background-color: #00CC33;
}

QTableWidget {
    background-color: #1E1E1E;
    alternate-background-color: #252525;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    gridline-color: #3A3A3A;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
    selection-background-color: #00FF41;
    selection-color: #000000;
}

QTableWidget::item {
    padding: 6px;
    border: none;
}

QHeaderView::section {
    background-color: #2A2A2A;
    color: #00FF41;
    padding: 6px;
    border: 1px solid #3A3A3A;
    font-weight: bold;
    font-family: "Segoe UI", Arial, sans-serif;
}

QHeaderView::section:hover {
    background-color: #333333;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    width: 14px;
    height: 14px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #555555;
    border-radius: 3px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #00FF41;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
}

QComboBox {
    background-color: #2A2A2A;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 6px 8px;
    min-height: 30px;
}

QComboBox:hover {
    border-color: #00FF41;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #2A2A2A;
    color: #FFFFFF;
    selection-background-color: #00FF41;
    selection-color: #000000;
    border: 1px solid #3A3A3A;
}

QLineEdit {
    background-color: #2A2A2A;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 6px;
}

QLineEdit:focus {
    border-color: #00FF41;
}

QDialog {
    background-color: #1E1E1E;
}

QMessageBox {
    background-color: #1E1E1E;
}

QMessageBox QLabel {
    color: #FFFFFF;
}

QToolTip {
    background-color: #2A2A2A;
    color: #FFFFFF;
    border: 1px solid #00FF41;
    padding: 4px;
}

/* Заставка */
QLabel#splash_title {
    color: #00FF41;
    font-size: 14pt;
    font-weight: bold;
    padding: 12px;
    border: none;
    background-color: transparent;
}

QLabel#splash_image {
    border: none;
    background-color: transparent;
    padding: 0;
}

QLabel#splash_subtitle {
    color: #CCCCCC;
    font-size: 12pt;
}

QLabel#splash_team {
    color: #888888;
    font-size: 10pt;
}

/* Форма настройки */
QLabel#setup_header {
    color: #00FF41;
    font-size: 13pt;
    font-weight: bold;
}

/* Панель данных занятия в главном окне */
QLabel#info_bar {
    color: #00FF41;
    background-color: #252525;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 6px;
    font-weight: bold;
}

/* Кадр калибровки и просмотр фото выстрела */
QLabel#calib_frame {
    border: 1px solid #00FF41;
    background-color: #1A1A1A;
}

QLabel#calib_hint {
    color: #AAAAAA;
}

/* Убираем серые внутренние рамки системных окон сообщений («Готово») */
QMessageBox {
    border: none;
}

QMessageBox QFrame {
    border: none;
    background-color: transparent;
}

QMessageBox QPushButton {
    min-height: 30px;
    padding: 4px 12px;
}
